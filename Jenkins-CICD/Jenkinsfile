pipeline {

    agent any

    environment {
        AWS_REGION      = 'ap-south-1'
        AWS_ACCOUNT     = '892387177992'
        ECR_REGISTRY    = "${AWS_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPOSITORY  = 'tetris'
        IMAGE_TAG       = "${BUILD_NUMBER}"
        IMAGE_NAME      = "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github-tetris',
                    url: 'https://github.com/vijaysanwal/Tetris-gamev1.git'
                )
            }
        }

        stage('Check Environment') {
            steps {
                sh '''
                    echo "===== Docker ====="
                    docker --version

                    echo "===== Docker Buildx ====="
                    docker buildx version

                    echo "===== AWS CLI ====="
                    aws --version

                    echo "===== Trivy ====="
                    trivy --version

                    echo "===== Helm ====="
                    helm version --short

                    echo "===== Image ====="
                    echo "${IMAGE_NAME}"
                '''
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    echo "Running Trivy filesystem scan..."

                    trivy fs \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        .
                '''
            }
        }

        stage('Docker Buildx Check') {
            steps {
                sh '''
                    echo "Checking Docker Buildx..."

                    docker buildx inspect --bootstrap
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                    echo "Logging in to ECR..."

                    aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                sh '''
                    echo "Building Tetris Docker image..."

                    docker buildx build \
                        --platform linux/arm64 \
                        -t ${IMAGE_NAME} \
                        --push .
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    echo "Pulling image for security scan..."

                    docker pull \
                        --platform linux/arm64 \
                        ${IMAGE_NAME}

                    echo "Running Trivy image scan..."

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        ${IMAGE_NAME}
                '''
            }
        }

        stage('Update Helm Image Tag') {
            steps {
                sh '''
                    echo "Updating Helm image tag..."

                    sed -i "s|tag: \".*\"|tag: \"${IMAGE_TAG}\"|" \
                        helm/tetris/values.yaml

                    echo "Updated Helm values:"

                    grep -n "repository\\|tag:" \
                        helm/tetris/values.yaml
                '''
            }
        }

        stage('Commit Helm Changes') {
            steps {
                sh '''
                    git config user.name "jenkins"
                    git config user.email "jenkins@localhost"

                    git add helm/tetris/values.yaml

                    if git diff --cached --quiet; then
                        echo "No Helm changes to commit."
                    else
                        git commit \
                            -m "Update Tetris image to ${IMAGE_TAG} [ci skip]"
                    fi
                '''
            }
        }
        stage('Push Helm Changes') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "Pushing Helm image tag update..."
        
                        git config credential.helper '!f() {
                            echo username=vijaysanwal
                            echo password=$GITHUB_TOKEN
                        }; f'
        
                        git push origin HEAD:main
        
                        git config --unset credential.helper
                    }
                }
            }
        }

    post {

        success {
            echo '=========================================='
            echo 'Tetris CI/CD Pipeline Completed'
            echo '=========================================='
            echo "Docker Image: ${IMAGE_NAME}"
            echo "Image Tag:    ${IMAGE_TAG}"
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo 'Tetris CI/CD Pipeline FAILED'
            echo '=========================================='
        }
    }
}
